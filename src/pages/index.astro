---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

const thumbnails = import.meta.glob<ImageMetadata>(
  ["../../public/*.{jpeg,png}", "../../public/fonts/IMG_*.jpeg"],
  { eager: true, import: "default" },
);

const fenceComparison = "077556FD-4725-4D69-BB76-1187CD879C1C.png";
const condenserComparison = "8CF66D22-2559-4941-93DD-C92C91FE39F1.png";
const dryerVentComparison = "E04E9ADB-A009-41A5-8961-CE8F5773530F.png";
const metalFence = ["IMG_3156.jpeg", "fonts/IMG_1186.jpeg", "fonts/IMG_1187.jpeg", "fonts/IMG_2678.jpeg"];
const captions: Record<string, string> = {
  "portfolio-barn-door-build.jpeg": "Custom wood barn door during fabrication",
  "portfolio-barn-door-installed.jpeg": "Custom sliding barn door installed",
  "portfolio-barn-door-hardware.jpeg": "Sliding barn door and track",
  "portfolio-wood-privacy-fence.jpeg": "Wood privacy fence installation",
  "portfolio-wood-privacy-fence-side.jpeg": "Wood privacy fence along the side yard",
  "portfolio-horizontal-privacy-fence.jpeg": "Horizontal wood privacy fence",
  "portfolio-stained-privacy-fence.jpeg": "Stained wood privacy fence",
  "portfolio-interior-paint-prep.jpeg": "Interior work with floors protected",
  "portfolio-plank-floor-installation.jpeg": "Plank flooring installation in progress",
  "portfolio-plank-floor-room.jpeg": "Plank flooring in a finished room",
  "portfolio-plank-floor-hallway.jpeg": "Plank flooring through a hallway",
  "portfolio-exterior-wall-framing.jpeg": "Exterior wall framing and sheathing",
  "portfolio-exterior-wall-sheathing.jpeg": "Sheathing installation around exterior openings",
  "portfolio-siding-wall-prep.jpeg": "Exterior wall preparation for siding",
  "portfolio-siding-installation.jpeg": "Lap siding installation",
  "portfolio-siding-finished-exterior.jpeg": "Blue exterior siding and trim",
  "portfolio-wood-deck.jpeg": "Wood deck construction",
  "portfolio-gravel-side-yard.jpeg": "Gravel walkway along the side yard",
  "portfolio-deck-enclosure.jpeg": "Exterior enclosure below a deck",
  "portfolio-exterior-framing.jpeg": "Exterior framing in progress",
  "portfolio-wood-panel-siding.jpeg": "Exterior wood panel siding",
  "portfolio-steel-cage-fabrication.jpeg": "Steel equipment cage during fabrication",
  "portfolio-steel-cage-installed.jpeg": "Installed steel equipment cage",
  "portfolio-metal-stair-railing.jpeg": "Metal railing along front steps",
  "portfolio-metal-porch-railing.jpeg": "Metal railing enclosing a porch",
  "portfolio-historic-brick-wall.jpeg": "Historic brick wall restoration in progress",
  "portfolio-historic-brick-scaffold.jpeg": "Scaffolding for historic brick restoration",
  "portfolio-salvaged-brick.jpeg": "Salvaged brick on a restoration jobsite",
  "portfolio-historic-brickwork.jpeg": "Brick restoration work from scaffold level",
  "portfolio-wall-repair-comparison.jpeg": "Exterior wall repair, before and after",
  [fenceComparison]: "Custom fence and gate, before and after",
  [condenserComparison]: "Condenser guard upgrade, before and after",
  [dryerVentComparison]: "Dryer vent repair, before and after",
  "IMG_3156.jpeg": "Custom fence and gate, before and after",
  "IMG_2957.jpeg": "Existing roof during tear-off",
  "IMG_2958.jpeg": "Tear-off and roof inspection",
  "IMG_2982.jpeg": "New shingles and roof vent",
  "IMG_2983.jpeg": "New shingles along the ridge",
  "IMG_2984.jpeg": "Completed shingle roof",
  "IMG_2985 (1).jpeg": "Completed shingle roof, second view",
};

const services = [
  {
    name: "Renovations & Repairs",
    desc: "Carpentry, framing, and property improvements.",
    photos: ["IMG_0795.jpeg", "IMG_0918.jpeg", "IMG_0919.jpeg", "IMG_0921.jpeg", "portfolio-barn-door-build.jpeg", "portfolio-barn-door-installed.jpeg", "portfolio-barn-door-hardware.jpeg"],
  },
  {
    name: "Fences & Gates",
    desc: "Wood and metal fences, custom gates, and repairs.",
    photos: [fenceComparison, ...metalFence, "fonts/IMG_1188.jpeg", "portfolio-wood-privacy-fence.jpeg", "portfolio-wood-privacy-fence-side.jpeg", "portfolio-horizontal-privacy-fence.jpeg", "portfolio-stained-privacy-fence.jpeg"],
  },
  {
    name: "Painting & Drywall",
    desc: "Interior and exterior painting, patching, and finishing.",
    photos: ["portfolio-interior-paint-prep.jpeg"],
  },
  {
    name: "Tile & Flooring",
    desc: "Tile, vinyl plank, and flooring repairs.",
    photos: ["portfolio-plank-floor-installation.jpeg", "portfolio-plank-floor-room.jpeg", "portfolio-plank-floor-hallway.jpeg"],
  },
  {
    name: "Exterior Improvements",
    desc: "Siding, sheathing, fascia, and exterior repairs.",
    photos: [dryerVentComparison, "IMG_0918.jpeg", "IMG_0919.jpeg", "IMG_0921.jpeg", "portfolio-exterior-wall-framing.jpeg", "portfolio-exterior-wall-sheathing.jpeg", "portfolio-siding-wall-prep.jpeg", "portfolio-siding-installation.jpeg", "portfolio-siding-finished-exterior.jpeg", "portfolio-wood-deck.jpeg", "portfolio-gravel-side-yard.jpeg", "portfolio-deck-enclosure.jpeg", "portfolio-exterior-framing.jpeg", "portfolio-wood-panel-siding.jpeg"],
  },
  {
    name: "Roofing & Roof Repairs",
    desc: "Shingle installation, leak repairs, and roofing maintenance.",
    photos: ["IMG_2957.jpeg", "IMG_2958.jpeg", "IMG_2982.jpeg", "IMG_2983.jpeg", "IMG_2984.jpeg", "IMG_2985 (1).jpeg"],
  },
  {
    name: "Welding & Metal Repairs",
    desc: "Custom metalwork and repairs for gates, fencing, and guards.",
    photos: [condenserComparison, ...metalFence, "portfolio-steel-cage-fabrication.jpeg", "portfolio-steel-cage-installed.jpeg", "portfolio-metal-stair-railing.jpeg", "portfolio-metal-porch-railing.jpeg"],
  },
  {
    name: "Masonry & Brick Restoration",
    desc: "Brickwork, tuckpointing, and chimney repairs.",
    photos: ["IMG_0944.jpeg", "IMG_0945.jpeg", "IMG_0947.jpeg", "IMG_0948.jpeg", "IMG_3410.jpeg", "IMG_3427.jpeg", "IMG_3428.jpeg", "IMG_3464.jpeg", "IMG_3465.jpeg", "IMG_3466.jpeg", "IMG_3467.jpeg", "portfolio-historic-brick-wall.jpeg", "portfolio-historic-brick-scaffold.jpeg", "portfolio-salvaged-brick.jpeg", "portfolio-historic-brickwork.jpeg", "portfolio-wall-repair-comparison.jpeg"],
  },
];
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content="SAM ENTERPRISES LLC provides renovations, repairs, roofing, fencing, painting, flooring, masonry and welding in the New Orleans area." />
  <title>SAM ENTERPRISES LLC | New Orleans Renovations &amp; Repairs</title>
  <style>
    :global(*) { box-sizing: border-box; }
    :global(body) { margin: 0; font-family: system-ui, sans-serif; background: #f5f3ee; color: #18232d; line-height: 1.55; }
    :global(:focus-visible) { outline: 3px solid #a56a20; outline-offset: 4px; }
    header, footer { background: #142b38; color: white; }
    header { text-align: center; padding: 24px 5%; }
    header img { display: block; width: 150px; height: auto; margin: 0 auto 12px; }
    .brand { font-size: 1.25rem; font-weight: 800; letter-spacing: .05em; }
    .tagline { margin: 4px 0 14px; color: #d8e1e6; }
    nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 24px; }
    nav a, footer a { color: white; }
    nav a { display: inline-flex; align-items: center; min-height: 44px; font-weight: 650; text-decoration: none; }
    nav a:hover { text-decoration: underline; }
    main, .footer-inner { max-width: 1120px; margin: auto; }
    section { padding: clamp(38px, 6vw, 68px) 5%; }
    .hero { text-align: center; }
    .eyebrow { color: #79521f; font-size: .85rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; }
    h1, h2, h3, p { margin-top: 0; }
    h1 { margin-bottom: 16px; font-size: clamp(2.1rem, 6vw, 4rem); line-height: 1.08; letter-spacing: -.045em; }
    h2 { margin-bottom: 10px; font-size: clamp(1.65rem, 4vw, 2.4rem); line-height: 1.15; }
    h3 { margin-bottom: 8px; }
    .hero p { max-width: 580px; margin: 0 auto 24px; font-size: 1.12rem; }
    .intro, .service-description, .hint, .gallery-body p { color: #465760; }
    .button { display: inline-flex; min-height: 48px; align-items: center; justify-content: center; padding: 11px 20px; border: 0; border-radius: 7px; background: #142b38; color: white; font: inherit; font-weight: 750; text-decoration: none; cursor: pointer; }
    .button:hover { background: #284859; }
    .button:disabled { opacity: .7; cursor: wait; }
    .services { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-top: 24px; align-items: start; }
    .service { background: white; border: 1px solid #d8d7d0; border-radius: 10px; }
    .service[open] { border-color: #a56a20; }
    summary { position: relative; display: block; padding: 17px 52px 17px 18px; border-radius: 10px; cursor: pointer; list-style: none; }
    summary::-webkit-details-marker { display: none; }
    summary:hover { background: #fbf8f2; }
    summary::after { content: "+" / ""; position: absolute; top: 17px; right: 17px; display: grid; width: 29px; height: 29px; place-items: center; background: #efe7d9; border-radius: 50%; color: #634216; font-weight: 750; }
    details[open] > summary::after { content: "−" / ""; }
    .service-name, .service-description, .service-action { display: block; }
    .service-name { font-size: 1.1rem; }
    .service-description { margin-top: 3px; }
    .service-action { margin-top: 8px; color: #79521f; font-weight: 700; font-size: .875rem; }
    .gallery-body { padding: 0 18px 18px; }
    .gallery-body p { margin-bottom: 10px; }
    .gallery { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; }
    .gallery a { display: block; border-radius: 6px; }
    .gallery img { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; background: #e5e1d8; border-radius: 6px; }
    .gallery figure { margin: 0; }
    .gallery figcaption { margin-top: 4px; color: #465760; font-size: .8rem; }
    .gallery .comparison img { object-fit: contain; background: #142b38; }
    .gallery a:hover img { filter: brightness(.9); }
    .about { background: #e9e6de; }
    .about p { max-width: 700px; margin-bottom: 0; }
    form { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; max-width: 780px; padding: clamp(16px, 4vw, 30px); background: white; border: 1px solid #d8d7d0; border-radius: 12px; }
    .field { display: grid; align-content: start; gap: 5px; min-width: 0; }
    .full { grid-column: 1 / -1; }
    label { font-weight: 650; }
    input, select, textarea { width: 100%; min-height: 46px; padding: 10px 12px; border: 1px solid #89979e; border-radius: 6px; background: white; color: inherit; font: inherit; }
    input[type="file"] { padding: 7px; }
    textarea { resize: vertical; }
    .hint, #request-status { margin: 0; }
    #request-status[data-state="error"] { color: #9b2f24; }
    #request-status[data-state="success"] { color: #17613d; }
    .form-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; }
    .email-link, .gallery-body p a { color: #234b60; }
    footer { padding: 32px 5%; }
    footer p { margin: 6px 0; }
    @media (max-width: 650px) {
      .services, form { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <header>
    <img src="/Sam-logo.jpg.jpg" alt="SAM Enterprises LLC logo" />
    <div class="brand">SAM ENTERPRISES LLC</div>
    <p class="tagline">Renovations &amp; Repairs · New Orleans</p>
    <nav aria-label="Main navigation">
      <a href="#services">Services &amp; Our Work</a>
      <a href="#about">About</a>
      <a href="#contact">Free Estimate</a>
    </nav>
  </header>

  <main>
    <section class="hero">
      <p class="eyebrow">New Orleans Area</p>
      <h1>Renovations and repairs<br />with attention to detail.</h1>
      <p class="intro">Hands-on work for homes and properties, from small repairs to larger improvements.</p>
      <a class="button" href="#contact">Request a Free Estimate</a>
    </section>

    <section id="services">
      <h2>Services &amp; Our Work</h2>
      <p class="intro">Choose a service to see project photos or ask about your job.</p>
      <div class="services">
        {services.map((service) => (
          <details class="service">
            <summary>
              <strong class="service-name">{service.name}</strong>
              <span class="service-description">{service.desc}</span>
              <span class="service-action">{service.photos.length ? `View photos (${service.photos.length})` : "Service details"}</span>
            </summary>
            <div class="gallery-body">
              {service.photos.length ? (
                <div class="gallery">
                  {service.photos.map((photo, index) => {
                    const url = `/${photo.split("/").map(encodeURIComponent).join("/")}`;
                    const caption = captions[photo];
                    const description = caption ?? `${service.name} project photo ${index + 1}`;
                    return (
                      <figure class:list={{ comparison: caption?.includes("before and after") }}>
                        <a href={url} target="_blank" rel="noopener noreferrer" aria-label={`Open ${description} in a new tab`}>
                          <Image src={thumbnails[`../../public/${photo}`]} width={560} format="webp" alt={description} loading="lazy" decoding="async" />
                        </a>
                        {caption && <figcaption>{caption}</figcaption>}
                      </figure>
                    );
                  })}
                </div>
              ) : (
                <p>Project photos are coming soon. <a href="#contact">Tell us about your project.</a></p>
              )}
            </div>
          </details>
        ))}
      </div>
    </section>

    <section class="about" id="about">
      <h2>Local Work. Personal Attention.</h2>
      <p>Steven Murillo leads SAM ENTERPRISES LLC and serves the New Orleans area. We take time to understand the job, explain the scope, and pay attention to the details.</p>
    </section>

    <section id="contact">
      <h2>Request a Free Estimate</h2>
      <p class="intro">Tell us what needs work and where the project is located.</p>
      <form id="estimate-form" action="https://formspree.io/f/maeelzaw" method="POST" enctype="multipart/form-data">
        <div class="field">
          <label for="customer-name">Full name</label>
          <input id="customer-name" name="name" autocomplete="name" required />
        </div>
        <div class="field">
          <label for="customer-email">Email</label>
          <input id="customer-email" name="email" type="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label for="customer-phone">Phone</label>
          <input id="customer-phone" name="phone" type="tel" autocomplete="tel" required />
        </div>
        <div class="field">
          <label for="project-type">Service</label>
          <select id="project-type" name="project_type" required>
            <option value="">Choose a service</option>
            {services.map(({ name }) => <option>{name}</option>)}
            <option>Other</option>
          </select>
        </div>
        <div class="field full">
          <label for="project-message">Project details</label>
          <textarea id="project-message" name="message" rows="4" maxlength="5000" placeholder="Describe the work, project location, and preferred timeline." required></textarea>
        </div>
        <div class="field full">
          <label for="project-photos">Project photos (optional)</label>
          <input id="project-photos" name="photos" type="file" accept="image/jpeg,image/png,image/webp" multiple aria-describedby="photo-help" />
          <small id="photo-help" class="hint">Up to five JPG, PNG, or WebP photos, 10 MB each.</small>
        </div>
        <div class="form-actions full">
          <button class="button" type="submit">Send Estimate Request</button>
          <a class="email-link" href="mailto:steven@samgc.com">Email Steven directly</a>
        </div>
        <p class="full" id="request-status" role="status" aria-live="polite"></p>
      </form>
    </section>
  </main>

  <footer>
    <div class="footer-inner">
      <strong>SAM ENTERPRISES LLC</strong>
      <p>New Orleans, Louisiana</p>
      <p><a href="mailto:steven@samgc.com">steven@samgc.com</a></p>
    </div>
  </footer>

  <script>
    const form = document.querySelector<HTMLFormElement>("#estimate-form");
    const photos = document.querySelector<HTMLInputElement>("#project-photos");
    const submit = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = document.querySelector<HTMLElement>("#request-status");

    if (form && photos && submit && status) {
      form.addEventListener("submit", async (event) => {
        event.preventDefault();
        if (submit.disabled) return;

        const files = Array.from(photos.files ?? []);
        const allowed = ["image/jpeg", "image/png", "image/webp"];
        if (files.length > 5 || files.some((file) => file.size > 10_000_000 || !allowed.includes(file.type))) {
          status.dataset.state = "error";
          status.textContent = "Choose up to five JPG, PNG, or WebP photos of 10 MB or less.";
          photos.focus();
          return;
        }

        const data = new FormData(form);
        if (!files.length) data.delete("photos");
        submit.disabled = true;
        status.dataset.state = "";
        status.textContent = "Sending your request…";

        try {
          const response = await fetch(form.action, {
            method: form.method,
            headers: { Accept: "application/json" },
            body: data,
          });
          if (!response.ok) throw new Error("Formspree rejected the request");
          form.reset();
          status.dataset.state = "success";
          status.textContent = "Thanks. Your estimate request was sent.";
        } catch {
          status.dataset.state = "error";
          status.textContent = "We couldn’t confirm delivery. Please try again or email Steven directly.";
        } finally {
          submit.disabled = false;
        }
      });
    }
  </script>
</body>
</html>
